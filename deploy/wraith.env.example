# WRAITH environment for a bare-metal/systemd host. Copy to /opt/wraith/wraith.env
# and edit. Keep it readable only by root (chmod 600 wraith.env) — it holds secrets.

WRAITH_HOST=0.0.0.0
WRAITH_PORT=8090

# The public URL victims reach (your IP or domain). Used to print correct hook /
# payload URLs. e.g. http://203.0.113.10:8090  or  https://wraith.example.com
WRAITH_PUBLIC_URL=http://YOUR_PUBLIC_IP:8090

# Operator login. REQUIRED when bound to a public interface — the server refuses
# to start on 0.0.0.0 without a password. Use a long, unique password.
WRAITH_OP_USER=operator
WRAITH_OP_PASSWORD=change-me-to-a-strong-password

# Signs the operator session cookie. Set a stable value so logins survive
# restarts. Generate one with:  openssl rand -hex 32
WRAITH_SECRET=replace-with-64-hex-characters

# Operator session lifetime (hours).
WRAITH_SESSION_HOURS=12
