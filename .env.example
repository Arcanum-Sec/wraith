# WRAITH environment. Copy to .env and edit, or just run ./setup.sh which
# generates this for you. NEVER commit the real .env — it holds secrets.

# Bind + port. In Docker, WRAITH_HOST is forced to 0.0.0.0 by compose; the port
# below is mapped to the same port on the host.
WRAITH_HOST=0.0.0.0
WRAITH_PORT=8090

# The public URL victims reach (your server's IP or domain). Used to print the
# correct hook/payload URLs. Examples:
#   http://203.0.113.10:8090
#   https://wraith.example.com
WRAITH_PUBLIC_URL=http://YOUR_PUBLIC_IP:8090

# Operator login. REQUIRED when bound publicly — the server refuses to start on
# a public interface without a password. Set a strong, unique password.
WRAITH_OP_USER=operator
WRAITH_OP_PASSWORD=change-me-to-a-strong-password

# Signs the operator session cookie. Keep it stable so logins survive restarts.
# Generate one with:  openssl rand -hex 32
WRAITH_SECRET=replace-with-64-hex-characters

# Operator session lifetime (hours).
WRAITH_SESSION_HOURS=12

# Blind-XSS mode: 1 (default) auto-fires Page Capture the instant a browser
# hooks; set to 0 for the manual BeEF-style "click to capture" flow.
WRAITH_AUTOCAPTURE=1
